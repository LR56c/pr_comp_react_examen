  "version": "0.0.0",
  "module": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "copy-to-cordova": "cp -r dist/* cordova/www && cp -r dist/assets/* cordova/www/assets && rm -rf dist",
    "clear-cordova": "rm -rf cordova/www/*",
    "cordova-run": "cd cordova && cordova run android",
    "cordova": "npm run build && npm run clear-cordova && npm run copy-to-cordova && npm run cordova-run"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "bootstrap": "^5.3.5",
    "firebase": "^11.6.0",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.9",
    "react-dom": "^19.0.0",
    "react-router": "^7.5.0",
    "react-simple-form-validator": "^0.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "postcss": "^8.4.12",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.2.0"
  }
